import java.util.Scanner;

public class Calculator {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.print("введите выражение например 2 * 6.5");
        String input = scanner.nextLine().trim();

        String[] parts = input.split("\\s+");

        if (parts.length != 3) {
            System.out.println("ошибка неверный формат. пример 2 * 6.5");
            return;
        }

        try {
            double a = Double.parseDouble(parts[0]);
            String op = parts[1];
            double b = Double.parseDouble(parts[2]);
            double result;

            switch (op) {
                case "+": result = a + b; break;
                case "-": result = a - b; break;
                case "*": result = a * b; break;
                case "/":
                    if (b == 0) {
                        System.out.println("ошибка деление на ноль");
                        return;
                    }
                    result = a / b;
                    break;
                default:
                    System.out.println("ошибка неизвестный оператор " + op);
                    return;
            }

            System.out.println("результат: " + result);
        } catch (NumberFormatException e) {
            System.out.println("ошибка не удалось распознать число");
        }
    }
}
