class Animal {
    void sound() { System.out.println("какой-то звук"); }
}

class Cat extends Animal {
    @Override
    void sound() { System.out.println("мяу"); }
}

class Dog extends Animal {
    @Override
    void sound() { System.out.println("гав"); }
}

public class Main {
    public static void main(String[] args) {
        Animal a1 = new Cat();
        Animal a2 = new Dog();
        a1.sound(); // мяу
        a2.sound(); // гав
    }
}
